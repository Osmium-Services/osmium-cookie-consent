<script nonce="<?= $cspNonce ?? '' ?>">
// Privacy Notice page search datalist handler
document.getElementById('privacy_page_search').addEventListener('input', function() {
    const val = this.value;
    const options = document.querySelectorAll('#privacy_pages_list option');
    let foundId = '';

    options.forEach(opt => {
        if (opt.value === val) {
            foundId = opt.dataset.id;
        }
    });

    document.getElementById('privacy_page_id').value = foundId;
});
</script>
